[3.103, "o", "exec\r\n/bin/bash -lc \"ffprobe -v error -show_entries format=duration,size,bit_rate -show_entries stream=codec_name,sample_rate,channels -of json output/episode.mp3; ffmpeg -v error -i output/episode.mp3 -f null -; python3 - <<'PY'\r\nfrom pathlib import Path\r\nimport json, re\r\nmaterials=json.loads(Path('output/materials.json').read_text())\r\nscript=Path('output/script.md').read_text()\r\nsummary=Path('output/summary.md').read_text()\r\nturns=re.findall(r'\"'^(\u7532|\u4e59)[\uff1a:]'\"\\\\s*(.+)\"'$'\"', script, re.M)\r\nprint({'materials':len(materials),'unique_urls':len({m['url'] for m in materials}),'degraded':sum(bool(m.get('degraded')) for m in materials),'summary_bullets':sum(line.startswith('- ') for line in summary.splitlines()),'script_chars':len(script),'turns':len(turns),'speaker_a':sum(s=='\u7532' for s,_ in turns),'speaker_b':sum(s=='\u4e59' for s,_ in turns)})\r\nPY\r\nls -lh output; git status --short\" in /Users/bytedance/Documents/ai-agent-digest\r\n"]
