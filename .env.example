# 飞书采集会话（用 lark-cli im +chat-search 查到后填入，形如 oc_xxx）
LARK_CHAT_ID=

# 火山引擎语音技术 - 新版控制台"API Key"（左侧导航 API Key 页面获取，需先开通"语音合成2.0"）
VOLC_SPEECH_API_KEY=
# 经典语音合成大模型2.0音色（甲=云舟男声/乙=Vivi女声），控制台"音色列表"可查完整清单
VOLC_VOICE_HOST_A=zh_male_m191_uranus_bigtts
VOLC_VOICE_HOST_B=zh_female_vv_uranus_bigtts

# 火山方舟对话模型（控制台 > API Key 管理 里新建一个，走 ARK OpenAI 兼容接口）
ARK_API_KEY=
ARK_CHAT_MODEL=doubao-seed-2-1-pro-260628
